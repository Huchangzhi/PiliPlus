# Local settings for the PiliPlus web proxy. Copy to .env or export directly.
HOST=127.0.0.1
PORT=8787

# CORS: "*" or a comma separated origin allowlist.
ALLOW_ORIGIN=*

# Optional shared token. When set, the client must send x-pili-token.
# PROXY_TOKEN=

# Optional extra host suffixes (comma separated). Built-in bilibili domains
# are always allowed. Every hostname is DNS-checked to resolve only to public
# addresses (IPv4 and IPv6 private/loopback/link-local targets are rejected).
# ALLOWED_HOSTS=example.com,example.org

# Serve the static build from here. Defaults to ../build/web.
# STATIC_DIR=/var/www/piliplus

# Set to 1 to log method + host + path. Cookies and query strings are never
# logged.
# LOG_REQUESTS=0
